@using Waker.UI
@using Waker.UI.Components.Molecules
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<Header />
<div class="body-content">
    @Body
</div>
<Toast @ref="_toast" />
<Footer />

@code {
    [SupplyParameterFromQuery]
    [Parameter]
    public string? Reload { get; set; }

    private Toast? _toast;

    protected override void OnInitialized()
    {
        NavigationService.Initialize(NavigationManager);
        NavigationService.Redirect();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _toast is not null && NavigationService.CheckIfReloaded(Reload))
        {
            await Task.Delay(10);
            _toast.Add(new("", DateTime.Now, "Refreshed!"));
        }
    }
}