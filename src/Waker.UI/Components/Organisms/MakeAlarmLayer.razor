@inject AlarmController AlarmController;
@inject SoundController SoundController;
@inject NavigationManager NavigationManager;
﻿
<AddTimerButton OnClick="ShowLayer" />
<ModalWindow @bind-IsVisible=_isVisible ActionAsync="SetAlarm">
    <div class="m-2">
        <DateSet @bind-Value="_date" @bind-Value:after="OnDateChangedAfter" />
    </div>

    <div class="d-flex flex-row justify-content-center">
        <div class="mx-2">@_date.Month</div>
        <div>月</div>
        <div class ="mx-2">@_date.Day</div>
        <div>日</div>
    </div>

    <ClockSet
        @bind-SelectedHour="_hour" @bind-SelectedMinute="_minute" 
        @bind-SelectedHour:after="CheckIfTimeIsPast" @bind-SelectedMinute:after="CheckIfTimeIsPast">
    </ClockSet>

    @if (_sounds is not null)
    {
        <select class="form-select" aria-label="Default select example" @bind="_seletedSoundIndex">
            @for (var i = 0; i < _sounds.Length; i++)
            {
                <option value="@i">@_sounds[i].DisplayName</option>
            }
        </select>
    }
</ModalWindow>

    @code {
    private string _hour = "00";
    private string _minute = "00";
    private bool _isVisible;
    private int _seletedSoundIndex = 0;
    private SoundEntity[]? _sounds;
    private DateOnly _date;
    private DateOnly _today => DateOnly.FromDateTime(DateTime.Today);
    private bool _isDateSetAtToday;

    protected override void OnInitialized()
    {
        _sounds = SoundController.GetEntities();
        _date = _today;
        _isDateSetAtToday = true;
    }

    private async Task ShowLayer()
    {
        _hour = DateTime.Now.Hour.ToString("d2");
        _minute = DateTime.Now.Minute.ToString("d2");
        _isVisible = true;
    }

    private async Task SetAlarm()
    {
        var dateTime = new DateTime(_date.Year, _date.Month, _date.Day, Convert.ToInt32(_hour), Convert.ToInt32(_minute), 0);
        var alarm = new AlarmEntity(dateTime, _sounds![_seletedSoundIndex]);
        AlarmController.Set(alarm);

        _ = NavigationService.DelayReload();
    }

    private void CheckIfTimeIsPast()
    {
        if (!_isDateSetAtToday) return;

        var now = DateTime.Now;
        var hourInt = Convert.ToInt32(_hour);
        if (hourInt < now.Hour || (hourInt == now.Hour && Convert.ToInt32(_minute) < now.Minute))
        {
            _date = _today.AddDays(1);
        }
        else
        {
            _date = _today;
        }
    }

    private void OnDateChangedAfter() => _isDateSetAtToday = _date == _today;
}
