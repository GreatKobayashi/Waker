@using Waker.Domain.Entities
<div class="card">
    <div class="card-body">
        @if (IsCancelable)
        {
            <div class="position-relative">
                <Button class="position-absolute end-0" OnClick="OnCancelButtonClick">
                    <i class="bi bi-trash-fill"></i>
                </Button>
            </div>
        }
        <h5 class="card-title">@Alarm.DateTime.ToString(_dateFormat)</h5>
        <h6 class="card-subtitle mb-2 text-body-secondary">one time</h6>
        @if (Alarm.StartedAt is not null)
        {
            <p>Alarm started at : @Alarm.StartedAt.Value.ToString(_dateFormat)</p>
        }
        @if (Alarm.StoppedAt is not null)
        {
            <p>Alarm stopped at : @Alarm.StoppedAt.Value.ToString(_dateFormat)</p>
        }
    </div>
</div>

@code {
    [Parameter]
    public required AlarmEntity Alarm { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public bool IsCancelable { get; set; }
    [Parameter]
    public EventCallback OnCancelButtonClick { get; set; }

    private static readonly string _dateFormat = "MM/dd HH : mm";
}
