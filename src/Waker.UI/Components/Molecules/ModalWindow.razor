@inject JSInterop JSInterop;

<div class="modal" @key="@_id" id="@_id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Modal title</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="() => IsVisible = false">Close</button>
                <button type="button" class="btn btn-primary">Understood</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private partial Task InitializeJS();
    private partial Task Show(string id);
    private partial Task Hide(string id);

    private static int _modals = 0;
    private string _id = "";

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await Show(_id);
        }
        else
        {
            await Hide(_id);
        }
    }

    protected override void OnInitialized()
    {
        _id = $"modalDialog{++_modals}";
        InitializeJS();
    }
}
