@inject JSInterop JSInterop;

<div class="modal fade pt-5" @key="@_id" id="@_id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @if (Title is not null)
            {
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">@Title</h1>
                    <button type="button" class="btn-close" @onclick="() => IsVisibleChanged.InvokeAsync(false)" aria-label="Close"></button>
                </div>
            }
            <div class="modal-body">
                @ChildContent
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary ms-0" @onclick="() => IsVisibleChanged.InvokeAsync(false)">@SecondaryButtonText</button>
                <button type="button" class="btn btn-primary" @onclick="CallAction">@PrimaryButtonText</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; }
    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public string? Title { get; set; }
    [Parameter]
    public string PrimaryButtonText { get; set; } = "OK";
    [Parameter]
    public string SecondaryButtonText { get; set; } = "CANCEL";
    [Parameter]
    public Action? Action { get; set; }
    [Parameter]
    public Func<Task>? ActionAsync { get; set; }

    private partial Task InitializeJS();
    private partial Task Show();
    private partial Task Hide();

    private static int _modals = 0;
    private string _id = "";

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await Show();
        }
        else
        {
            await Hide();
        }
    }

    protected override void OnInitialized()
    {
        _id = $"modalDialog{++_modals}";
        InitializeJS();
    }

    private async void CallAction()
    {
        if (Action is not null)
        {
            Action();
        }

        if (ActionAsync is not null)
        {
            await ActionAsync();
        }

        await IsVisibleChanged.InvokeAsync(false);
    }
}
